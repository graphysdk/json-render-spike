{
  "name": "@graphysdk/json-render",
  "author": "Graphy",
  "description": "A Graphy grammar-of-graphics chart as one component in a json-render catalog",
  "homepage": "https://docs.graphy.dev/sdk-next/quickstart",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "graphy",
    "json-render",
    "chart",
    "generative-ui",
    "ai",
    "grammar-of-graphics"
  ],
  "version": "1.8.0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "local": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "local": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "TZ=utc vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@graphysdk/react": ">=1.8.0-0",
    "@graphysdk/viz-engine": ">=1.8.0-0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@graphysdk/react": "1.8.1-beta.1787132472323",
    "@graphysdk/viz-engine": "1.8.1-beta.1787132472323",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup-plugin-node-externals": "^8.1.1",
    "tslib": "^2.8.1",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.mjs",
        "require": "./dist/server.cjs"
      }
    }
  }
}
