{
  "name": "@graphyapp/json-render-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --conditions=local server/src/start.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p server/tsconfig.json && vite build --config web/vite.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@graphysdk/json-render": "workspace:*",
    "@graphysdk/react": "workspace:*",
    "@graphysdk/viz-engine": "workspace:*",
    "@hono/node-server": "^2.0.10",
    "@json-render/codegen": "^0.19.0",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@json-render/shadcn": "^0.19.0",
    "@tailwindcss/vite": "^4.3.1",
    "ai": "^6.0.0",
    "dotenv": "^16.4.7",
    "hono": "^4.12.27",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphytools/eslint-config": "workspace:*",
    "@graphytools/typescript-config": "workspace:*",
    "@graphytools/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.3",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vite": "^8.1.0",
    "vitest": "catalog:"
  }
}
